  "fixed_sql": [
    {
      "name": "categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"color\" TEXT NOT NULL, \"icon\" TEXT NOT NULL);"
        }
      ]
    },
    {
      "name": "folders",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"folders\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"image_path\" TEXT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"is_deleted\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_deleted\" IN (0, 1)), \"deleted_at\" INTEGER NULL, \"parent_id\" INTEGER NULL REFERENCES folders (id) ON DELETE SET NULL, \"category_id\" INTEGER NOT NULL REFERENCES categories (id) ON DELETE SET NULL);"
        }
      ]
    },
    {
      "name": "items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"items\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"image_path\" TEXT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"updated_at\" INTEGER NULL, \"category_id\" INTEGER NOT NULL REFERENCES categories (id) ON DELETE SET NULL, \"folder_id\" INTEGER NULL REFERENCES folders (id) ON DELETE SET NULL, \"is_deleted\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_deleted\" IN (0, 1)), \"deleted_at\" INTEGER NULL);"
        }
      ]
    },
    {
      "name": "reviews",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"reviews\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"rating\" INTEGER NOT NULL DEFAULT 1 CHECK(\"rating\" BETWEEN 1 AND 10), \"comment\" TEXT NOT NULL, \"deleted\" INTEGER NOT NULL DEFAULT 0, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"updated_at\" INTEGER NULL, \"item_id\" INTEGER NOT NULL REFERENCES items (id) ON DELETE SET NULL);"
        }
      ]
    },
    {
      "name": "review_images",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"review_images\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"image_path\" TEXT NOT NULL, \"review_id\" INTEGER NULL REFERENCES reviews (id) ON DELETE SET NULL);"
        }
      ]
    },
    {
      "name": "folders_index",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX folders_index ON folders (category_id, parent_id, is_deleted)"
        }
      ]
    },
    {
      "name": "items_index",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX items_index ON items (category_id, folder_id, is_deleted)"
        }
      ]
    },
    {
      "name": "review_images_index",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX review_images_index ON review_images (review_id)"
        }
      ]
